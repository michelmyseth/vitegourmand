# Docker Compose variables — copy to .env and adapt (optional: defaults are used otherwise)

# PostgreSQL
POSTGRES_USER=vitegourmand
POSTGRES_PASSWORD=vitegourmand
POSTGRES_DB=vitegourmand

# Secret used to sign the authentication tokens (use a long random value)
JWT_SECRET=change-me

# Host ports, if 5432 / 27017 are already used on your machine
POSTGRES_HOST_PORT=5432
MONGO_HOST_PORT=27017
